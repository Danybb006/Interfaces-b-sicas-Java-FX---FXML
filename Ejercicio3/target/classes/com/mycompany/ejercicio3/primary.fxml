<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio3.PrimaryController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="Ingrese un número" />
            <TextField fx:id="txtNumero" prefWidth="120.0" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#analizar" text="Analizar" />
                  <Button mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
               </children>
            </HBox>
         </children>
      </HBox>
      <HBox spacing="30.0">
         <children>
            <GridPane hgap="15.0" vgap="10.0">
               <children>
                  <Label text="Cantidad de cifras" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtCantCifras" editable="false" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Suma de cifras impares" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtSumaImpares" editable="false" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Suma de cifras pares" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtSumaPares" editable="false" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Suma total de cifras" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="txtSumaTotal" editable="false" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Cifra mayor" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <TextField fx:id="txtCifraMayor" editable="false" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="Cifra menor" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <TextField fx:id="txtCifraMenor" editable="false" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               </children>
            </GridPane>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Divisores" />
                  <TextArea fx:id="txtDivisores" editable="false" prefHeight="200.0" prefWidth="150.0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>