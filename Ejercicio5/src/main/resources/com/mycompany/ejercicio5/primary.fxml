<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio5.PrimaryController">
   <children>
      <HBox spacing="30.0">
         <children>
            <GridPane hgap="10.0" vgap="10.0">
               <children>
                  <Label text="Alimentación" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtAlimentacion" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Refrigerios" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtRefrigerios" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Transporte" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtTransporte" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Telefonía" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="txtTelefonia" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Otros" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <TextField fx:id="txtOtros" prefWidth="80.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            <VBox spacing="10.0">
               <children>
                  <Label text="Estadísticas" />
                  <Label text="Total semanal" />
                  <TextField fx:id="txtTotalSemanal" editable="false" prefWidth="120.0" />
                  <Label text="Gasto más alto" />
                  <TextField fx:id="txtGastoMasAlto" editable="false" prefWidth="120.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#calcularEstadisticas" prefHeight="40.0" prefWidth="120.0" text="Calcular estadísticas" textAlignment="CENTER" wrapText="true" />
            <Button mnemonicParsing="false" onAction="#limpiar" prefHeight="40.0" prefWidth="100.0" text="Limpiar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
