<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio4.PrimaryController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="50.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <Label text="Tabla del:" />
                  <TextField fx:id="txtNumero" prefWidth="50.0" />
               </children>
            </VBox>
            <VBox spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#calcular" prefWidth="80.0" text="Calcular" />
                  <Button mnemonicParsing="false" onAction="#limpiar" prefWidth="80.0" text="Limpiar" />
               </children>
            </VBox>
         </children>
      </HBox>
      <TextArea fx:id="txtAreaTabla" editable="false" prefHeight="220.0" prefWidth="250.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>